# Production .env for docker-compose.prod.yml. Copy to .env in the repository root on the
# server, fill in every value, and `chmod 600 .env`. Generate each secret with:
#   openssl rand -hex 32
# Hex keeps the Postgres password safe to embed in DATABASE_URL.
# Keep a copy of this file somewhere safe (a password manager). Losing API_KEY_PEPPER
# invalidates every issued API key, and CODE_SECRET must stay fixed for the life of the
# deployment (see .env.example).

# Makes a plain `docker compose ...` on the server use the production overrides.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Hostname whose DNS A record points at this server. Caddy gets its certificate, and short
# links are returned as https://DOMAIN/<code>.
DOMAIN=links.example.com

POSTGRES_PASSWORD=
CODE_SECRET=
API_KEY_PEPPER=

# Optional tuning (defaults shown).
# WEB_CONCURRENCY=2
# RATE_LIMIT_CREATE_PER_KEY=60
# RATE_LIMIT_CREATE_PER_IP=120
# LOG_LEVEL=INFO
