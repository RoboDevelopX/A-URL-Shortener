# Copy to .env for running the API on the host (`uv run uvicorn --factory app.main:create_app`).
# docker compose reads the same variables; anything unset falls back to dev-only defaults.

ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://shortener:shortener-dev-password@localhost:5432/shortener
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
REDIS_CIRCUIT_COOLDOWN_SECONDS=5
CACHE_TTL_SECONDS=600
NEGATIVE_CACHE_TTL_SECONDS=30

# HMAC key for API key hashes. Rotating it invalidates every issued key.
API_KEY_PEPPER=change-me
# Link creation limits (sliding window)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CREATE_PER_KEY=60
RATE_LIMIT_CREATE_PER_IP=120

# Click analytics pipeline (Redis Stream -> worker -> Postgres)
CLICK_STREAM_KEY=clicks:stream
CLICK_CONSUMER_GROUP=click-writers
CLICK_STREAM_MAX_LENGTH=500000
WORKER_BATCH_SIZE=500
WORKER_BLOCK_MS=1000
WORKER_CLAIM_IDLE_MS=60000

PUBLIC_BASE_URL=http://localhost:8000
CODE_LENGTH=7
# Key for the short-code permutation. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set once per deployment and never rotate (rotation re-maps future ids onto existing codes).
CODE_SECRET=change-me
MAX_URL_LENGTH=2048

# Malicious-URL screening. Thresholds default to the values chosen at training time
# (artifacts/url_classifier.json); uncomment to override.
MODEL_PATH=artifacts/url_classifier.joblib
# ML_BLOCK_THRESHOLD=0.93
# ML_REVIEW_THRESHOLD=0.72

# Used by docker compose only
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener-dev-password
POSTGRES_DB=shortener
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_CONCURRENCY=2
